# media-stack configuration. install.sh generates the real .env from your prompt answers
# (values are single-quoted; re-running the installer keeps these as the defaults).
# This example documents every variable. Secrets (passwords, API keys) live in secrets.env, not here.

# --- identity / host ---
STACK_NAME=mediastack
SERVER_HOST=192.168.1.10          # LAN IP used in every URL (auto-detected)
TZ=Australia/Sydney
PUID=1000
PGID=1000

# --- paths ---
CONFIG_DIR=/srv/media/config      # per-app config/databases (back this up)
DATA_DIR=/srv/media/data          # the library: media/{movies,tv}

# --- which optional services run (Compose profiles, comma-separated) ---
# The core (Jellyfin, Jellyseerr, Radarr, Sonarr, Bazarr, Controllarr, autoheal) has no profile and always runs.
# notify=ntfy
COMPOSE_PROFILES=notify

# --- ports (override only if a default clashes) ---
JELLYFIN_PORT=8096
RADARR_PORT=7878
SONARR_PORT=8989
JELLYSEERR_PORT=5055
BAZARR_PORT=6767
NTFY_PORT=8090
CONTROLLARR_PORT=3002
CONTROLLARR_REFRESH=15            # control-panel data regeneration interval (seconds)

# --- the control panel, from its own repository ---
CONTROLLARR_REPO=https://github.com/lochlannfoster/controllarr.git
CONTROLLARR_REF=v0.1.0            # a tag: the panel version this stack was tested against. `main` tracks
                                  # the tip, so two installs a week apart differ — pin unless you mean that.

# --- behaviour knobs (applied by the installer; change live from the panel's Settings) ---
AUDIO_LANGUAGE=Original           # Original = the title's native language (Radarr only; Sonarr v4 has no such field)
# Release sizes, custom formats and their scores are NOT set here: they come from TRaSH Guides, previewed and
# applied from Controllarr (Settings > Quality & size > TRaSH Guides). Nothing in this stack writes them unasked.
SUBTITLE_LANGS=en
MEDIAUSER_COUNT=1                 # number of MEDIAUSER_N records in secrets.env
ENABLE_WARDENS=true               # self-healing cron jobs (see docs/AUTOMATION.md)
NOTIFY_QUIET_START=0              # media-topic notifications are silent between these hours
NOTIFY_QUIET_END=9
NTFY_TOPIC_MEDIA=media
NTFY_TOPIC_ADMIN=admin
NTFY_URL=                         # blank = the stack's own ntfy; set to use an external ntfy server

# --- backups ---
ENABLE_BACKUPS=true
BACKUP_DIR=/srv/media/backups     # local encrypted nightly config backups (passphrase lives in CONFIG_DIR/.backup-passphrase)
BACKUP_KEEP=7

# --- remote access (optional, recommended) ---
# Tailscale puts this box on your private network so you can watch away from home without opening a
# port on the router. The auth key lives in tailscale.env (600, gitignored).
TAILSCALE_ENABLED=false
TAILSCALE_HOSTNAME=mediastack     # the node's name in your tailnet

# --- VPN (optional): a gluetun tunnel for the services that talk to third parties ---
# Written by install.sh. The provider's own settings live in vpn.env (gitignored, never here).
# VPN_ROUTE is the space-separated list of services sharing gluetun's network namespace; empty
# means no tunnel is created. See docs/services/gluetun.md.
VPN_ENABLED=false
VPN_ROUTE=                        # e.g. "radarr sonarr bazarr"
